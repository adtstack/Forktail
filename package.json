{
  "name": "forktail",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude scripts/git-tool-smoke.integration.test.mjs",
    "test:git-tools": "vitest run scripts/git-tool-smoke.integration.test.mjs --no-file-parallelism --hookTimeout=60000 --testTimeout=60000",
    "test:watch": "vitest --exclude scripts/git-tool-smoke.integration.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "doctor": "node scripts/doctor.mjs",
    "smoke:runtime:prepare": "node scripts/prepare-runtime-smoke.mjs",
    "smoke:runtime:verify": "node scripts/prepare-runtime-smoke.mjs --verify",
    "smoke:git-tools:prepare": "node scripts/git-tool-smoke.mjs",
    "smoke:git-tools:install": "node scripts/git-tool-smoke.mjs --install-config",
    "smoke:git-tools:run": "node scripts/git-tool-smoke.mjs --run",
    "smoke:git-tools:capture-external": "node scripts/git-tool-smoke.mjs --capture-external-change",
    "smoke:git-tools:verify": "node scripts/git-tool-smoke.mjs --verify",
    "smoke:git-tools:cleanup": "node scripts/git-tool-smoke.mjs --cleanup",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "updater:config": "node scripts/write-updater-config.mjs",
    "updater:manifest": "node scripts/generate-updater-manifest.mjs",
    "updater:promotion": "node scripts/validate-updater-promotion.mjs",
    "tauri": "tauri",
    "check": "npm run typecheck && npm run test && npm run test:git-tools && npm run build"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "monaco-editor": "0.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
