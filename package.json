{
  "name": "forktail",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "doctor": "node scripts/doctor.mjs",
    "smoke:runtime:prepare": "node scripts/prepare-runtime-smoke.mjs",
    "smoke:runtime:verify": "node scripts/prepare-runtime-smoke.mjs --verify",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "tauri": "tauri",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "monaco-editor": "0.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
